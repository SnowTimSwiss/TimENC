<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.SnowTimSwiss.TimENC</id>

  <name>TimENC</name>
  <summary>Secure file encryption tool</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <developer id="io.github.snowtimswiss">
    <name>SnowTimSwiss</name>
  </developer>

  <description>
    <p>
      TimENC is a secure file encryption tool. It protects your files using
      ChaCha20-Poly1305 authenticated encryption with Argon2id key derivation.
    </p>
    <p>Features:</p>
    <ul>
      <li>ChaCha20-Poly1305 authenticated encryption</li>
      <li>Argon2id password-based key derivation</li>
      <li>Simple, cross-platform graphical interface</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.SnowTimSwiss.TimENC.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Encrypting a file in TimENC</caption>
      <image>https://raw.githubusercontent.com/SnowTimSwiss/TimENC/main/Images/Screenshot-Encrypt.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/SnowTimSwiss/TimENC</url>
  <url type="bugtracker">https://github.com/SnowTimSwiss/TimENC/issues</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="3.0.0" date="2026-08-07">
      <description>
        <p>New v6 file format with stronger integrity guarantees.</p>
        <ul>
          <li>Truncating an encrypted file is now detected instead of silently producing a shortened result.</li>
          <li>Files are bound to a single password, and a wrong password is rejected instantly.</li>
          <li>Optional padding hides the exact size of the encrypted file.</li>
          <li>Selectable key derivation strength: balanced or paranoid.</li>
          <li>Files from all earlier versions can still be decrypted.</li>
        </ul>
      </description>
    </release>
    <release version="2.2.2" date="2026-06-28">
      <description>
        <p>Fix decryption failing inside the Flatpak sandbox (cross-device link error).</p>
      </description>
    </release>
    <release version="2.2.1" date="2026-06-27">
      <description>
        <p>Transparent app icon and a more compact window layout.</p>
      </description>
    </release>
    <release version="2.2.0" date="2026-06-27">
      <description>
        <p>TimENC v2.2.0.</p>
      </description>
    </release>
  </releases>
</component>
